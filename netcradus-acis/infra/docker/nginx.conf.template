server {
    listen 80;
    server_name _;

    # Real security response headers — this container only ever runs behind
    # Caddy's TLS termination in prod (see docker-compose.prod.yml network
    # isolation: only caddy publishes host ports), so HSTS is always accurate
    # here, not conditional on a per-request scheme check.
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header Permissions-Policy "geolocation=(), camera=(), microphone=()" always;
    # connect-src stays broad on scheme (https:/wss:/ws:) rather than a
    # hardcoded Keycloak host, since VITE_KEYCLOAK_URL is a build-time arg
    # that can point at a different origin per deployment — an overly strict
    # connect-src would silently break login rather than fail loudly.
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self' https: wss: ws:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" always;

    # Docker's embedded DNS. Without this, nginx resolves the gateway
    # hostname exactly once at config-load time and REFUSES TO START if it
    # isn't resolvable yet (e.g. gateway container still starting, or
    # recreated with a new IP during a rolling deploy) — using a variable in
    # proxy_pass (below) defers resolution to request time using this resolver.
    resolver 127.0.0.11 valid=10s;

    # React SPA
    location / {
        root /usr/share/nginx/html;
        index index.html;
        try_files $uri $uri/ /index.html;
    }

    # REST API — proxied to acis-gateway (Spring Cloud Gateway), which routes
    # onward to the individual backend microservices.
    location /api/ {
        set $upstream_gateway ${GATEWAY_UPSTREAM};
        proxy_pass $upstream_gateway;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # STOMP-over-SockJS WebSocket endpoints — same gateway, upgraded connection.
    location /ws/ {
        set $upstream_gateway ${GATEWAY_UPSTREAM};
        proxy_pass $upstream_gateway;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 3600s;
    }
}
