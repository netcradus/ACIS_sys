server {
    listen 80;
    server_name _;

    # Docker's embedded DNS. Without this, nginx resolves the gateway
    # hostname exactly once at config-load time and REFUSES TO START if it
    # isn't resolvable yet (e.g. gateway container still starting, or
    # recreated with a new IP during a rolling deploy) — using a variable in
    # proxy_pass (below) defers resolution to request time using this resolver.
    resolver 127.0.0.11 valid=10s;

    # React SPA
    location / {
        root /usr/share/nginx/html;
        index index.html;
        try_files $uri $uri/ /index.html;
    }

    # REST API — proxied to acis-gateway (Spring Cloud Gateway), which routes
    # onward to the individual backend microservices.
    location /api/ {
        set $upstream_gateway ${GATEWAY_UPSTREAM};
        proxy_pass $upstream_gateway/api/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # STOMP-over-SockJS WebSocket endpoints — same gateway, upgraded connection.
    location /ws/ {
        set $upstream_gateway ${GATEWAY_UPSTREAM};
        proxy_pass $upstream_gateway/ws/;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 3600s;
    }
}
