{
  "title": "ACIS Production Overview",
  "uid": "acis-overview",
  "timezone": "utc",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    { "id": 1, "type": "row", "title": "App — requests, errors, latency", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 } },
    {
      "id": 2, "type": "timeseries", "title": "Request rate by service",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [{ "expr": "sum by (job) (rate(http_server_requests_seconds_count[5m]))", "legendFormat": "{{job}}" }]
    },
    {
      "id": 3, "type": "timeseries", "title": "5xx error rate by service",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "percentunit" }, "overrides": [] },
      "targets": [{ "expr": "sum by (job) (rate(http_server_requests_seconds_count{status=~\"5..\"}[5m])) / sum by (job) (rate(http_server_requests_seconds_count[5m]))", "legendFormat": "{{job}}" }]
    },
    {
      "id": 4, "type": "timeseries", "title": "p99 request latency by service",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 9 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [{ "expr": "histogram_quantile(0.99, sum by (job, le) (rate(http_server_requests_seconds_bucket[5m])))", "legendFormat": "{{job}}" }]
    },
    {
      "id": 5, "type": "timeseries", "title": "JVM heap usage by service",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 9 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "percentunit" }, "overrides": [] },
      "targets": [{ "expr": "sum by (job) (jvm_memory_used_bytes{area=\"heap\"}) / sum by (job) (jvm_memory_max_bytes{area=\"heap\"})", "legendFormat": "{{job}}" }]
    },

    { "id": 10, "type": "row", "title": "Infra — service availability & container resources", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 17 } },
    {
      "id": 11, "type": "stat", "title": "Services up / total",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 18 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [{ "expr": "sum(up)" }, { "expr": "count(up)" }],
      "fieldConfig": { "defaults": { "custom": {} }, "overrides": [] }
    },
    {
      "id": 12, "type": "table", "title": "Down targets (should be empty)",
      "gridPos": { "h": 6, "w": 18, "x": 6, "y": 18 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [{ "expr": "up == 0", "format": "table", "instant": true }]
    },
    {
      "id": 13, "type": "timeseries", "title": "Container memory usage",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
      "targets": [{ "expr": "sum by (name) (container_memory_usage_bytes{name!=\"\"})", "legendFormat": "{{name}}" }]
    },
    {
      "id": 14, "type": "timeseries", "title": "Container CPU usage (cores)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [{ "expr": "sum by (name) (rate(container_cpu_usage_seconds_total{name!=\"\"}[5m]))", "legendFormat": "{{name}}" }]
    },

    { "id": 20, "type": "row", "title": "Database", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 32 } },
    {
      "id": 21, "type": "stat", "title": "Postgres up",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 33 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [{ "expr": "pg_up" }]
    },
    {
      "id": 22, "type": "timeseries", "title": "HikariCP pool usage by service",
      "gridPos": { "h": 8, "w": 18, "x": 6, "y": 33 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "percentunit" }, "overrides": [] },
      "targets": [{ "expr": "sum by (job) (hikaricp_connections_active) / sum by (job) (hikaricp_connections_max)", "legendFormat": "{{job}}" }]
    },

    { "id": 30, "type": "row", "title": "Business health", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 41 } },
    {
      "id": 31, "type": "timeseries", "title": "Auth failures (401/403) at the gateway",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 42 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [{ "expr": "sum(rate(http_server_requests_seconds_count{job=\"acis-gateway\", status=~\"401|403\"}[5m]))", "legendFormat": "401/403 per sec" }]
    },
    {
      "id": 32, "type": "timeseries", "title": "Ingestion service error rate",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 42 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [{ "expr": "sum(rate(http_server_requests_seconds_count{job=\"acis-ingestion\", status=~\"5..\"}[5m]))", "legendFormat": "5xx per sec" }]
    }
  ],
  "templating": {
    "list": [
      {
        "name": "DS_PROMETHEUS",
        "type": "datasource",
        "query": "prometheus",
        "current": { "text": "Prometheus", "value": "Prometheus" },
        "hide": 0
      }
    ]
  }
}
