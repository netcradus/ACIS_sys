# Real Alertmanager routing — grouped and rate-limited so a cascading
# failure (e.g. Postgres going down, which trips PostgresDown +
# HikariPoolNearExhaustion + ServiceDown for every backend at once) sends
# ONE grouped notification, not a dozen separate pages.
#
# This is a TEMPLATE, not the file Alertmanager actually reads. Unlike
# docker-compose.yml or nginx's built-in templating, Alertmanager's own
# config format has no environment-variable interpolation - `${VAR}` here
# would be sent to a receiver literally if handed to Alertmanager as-is.
# infra/scripts/deploy.sh renders this into infra/monitoring/alertmanager.yml
# (gitignored, contains real secret values) using the project's REAL
# already-configured SMTP credentials — the exact same SMTP_HOST/PORT/
# USERNAME/PASSWORD/MAIL_FROM_EMAIL that acis-soar/acis-platform-admin
# already use for invitation emails (docker-compose.prod.yml), so there is
# no new credential to provision - only ALERTMANAGER_ALERT_EMAIL (who
# receives alerts) needs to be set in .env. An optional Slack webhook can
# be added additionally via ALERTMANAGER_SLACK_WEBHOOK_URL.
global:
  resolve_timeout: 5m
  smtp_from: '${MAIL_FROM_EMAIL}'
  smtp_smarthost: '${SMTP_HOST}:${SMTP_PORT}'
  smtp_auth_username: '${SMTP_USERNAME}'
  smtp_auth_password: '${SMTP_PASSWORD}'
  smtp_require_tls: true
  # Port 465 (this project's real SMTP host, smtppro.zoho.eu, included) is
  # implicit TLS - the whole connection is TLS from the first byte (RFC
  # 8314), never STARTTLS. smtp_require_tls above only controls the
  # STARTTLS/opportunistic-TLS path; without this, v0.34.0's auto-detect
  # covers port 465 already, but this is set explicitly rather than relied
  # on implicitly (found the hard way: a real send to smtppro.zoho.eu:465
  # failed under v0.27.0, which had no implicit-TLS support at all - see
  # docker-compose.prod.yml's alertmanager image comment).
  smtp_force_implicit_tls: true

route:
  group_by: ['alertname', 'severity']
  group_wait: 30s
  group_interval: 5m
  repeat_interval: 4h
  receiver: 'default'
  routes:
    - match:
        severity: critical
      receiver: 'critical'
      repeat_interval: 1h

receivers:
  - name: 'default'
    email_configs:
      - to: '${ALERTMANAGER_ALERT_EMAIL}'
        send_resolved: true

  - name: 'critical'
    email_configs:
      - to: '${ALERTMANAGER_ALERT_EMAIL}'
        send_resolved: true
    # This line is deleted entirely by deploy.sh's render step when
    # ALERTMANAGER_SLACK_WEBHOOK_URL is unset (Alertmanager requires a
    # non-empty api_url whenever slack_configs is present at all, so an
    # empty/placeholder url is not a safe default) - written in YAML flow
    # style so the whole receiver is one line, safe to substitute with sed.
    __SLACK_CONFIGS_LINE__

inhibit_rules:
  # If Postgres itself is down, suppress the pool-exhaustion/service-down
  # alerts that are a direct, expected consequence of that same root cause -
  # one root-cause alert, not a storm of derivative ones.
  - source_match:
      alertname: 'PostgresDown'
    target_match_re:
      alertname: 'HikariPool.*|ServiceDown'
    equal: []
