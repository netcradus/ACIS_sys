<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.netcradus.acis</groupId>
  <artifactId>acis-async-reset-email</artifactId>
  <version>1.0.0</version>
  <packaging>jar</packaging>

  <!--
    Standalone Keycloak SPI provider — deliberately NOT part of the
    backend/ Spring Boot Maven reactor (different runtime entirely: this
    JAR is loaded directly by Keycloak's own Quarkus process, not run as
    an acis-* microservice). Fixes VAPT M-03's residual finding: the
    built-in reset-credential-email authenticator blocks on the real SMTP
    round-trip before responding, so response time alone reveals whether
    a submitted username is a real account. This provider defers only the
    actual email send (the genuinely slow, network-bound part) to a
    background thread, so the HTTP response returns in comparable time
    regardless of whether the account exists.

    All keycloak-* dependencies are `provided`: at runtime these classes
    are already on Keycloak's own classpath, and bundling them here would
    create duplicate/conflicting classes when this JAR is dropped into
    /opt/keycloak/providers/.
  -->

  <properties>
    <maven.compiler.release>17</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <!-- Bumped 24.0.0 -> 26.7.0 alongside infra/keycloak/Dockerfile's base
         image, to fix real CRITICAL container CVEs (CVE-2025-14813 in the
         bundled BouncyCastle jars) and the bulk of the accumulated HIGH
         findings in the 24.0.5 image. Authenticator/AuthenticatorFactory
         (this provider's only SPI surface) is one of Keycloak's most
         stable, long-standing extension points - verified via a real
         local build+migration+login test against a backed-up copy of the
         Keycloak DB before touching AWS production. -->
    <keycloak.version>26.7.0</keycloak.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.keycloak</groupId>
      <artifactId>keycloak-server-spi</artifactId>
      <version>${keycloak.version}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.keycloak</groupId>
      <artifactId>keycloak-server-spi-private</artifactId>
      <version>${keycloak.version}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.keycloak</groupId>
      <artifactId>keycloak-services</artifactId>
      <version>${keycloak.version}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.keycloak</groupId>
      <artifactId>keycloak-core</artifactId>
      <version>${keycloak.version}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>jakarta.ws.rs</groupId>
      <artifactId>jakarta.ws.rs-api</artifactId>
      <version>3.1.0</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.jboss.logging</groupId>
      <artifactId>jboss-logging</artifactId>
      <version>3.5.3.Final</version>
      <scope>provided</scope>
    </dependency>
  </dependencies>

  <build>
    <finalName>acis-async-reset-email</finalName>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
      </plugin>
    </plugins>
  </build>
</project>
