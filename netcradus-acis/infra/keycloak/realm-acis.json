{
  "realm": "acis",
  "enabled": true,
  "displayName": "NETCRADUS ACIS",
  "displayNameHtml": "<strong>NETCRADUS</strong> ACIS",
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "editUsernameAllowed": true,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "roles": {
    "realm": [
      { "name": "viewer",   "description": "Read-only access to dashboards and logs" },
      { "name": "analyst",  "description": "Alert investigation and triage" },
      { "name": "engineer", "description": "Rule authoring and system configuration" },
      { "name": "admin",    "description": "Full administrative access" },
      { "name": "company-admin", "description": "Tenant owner - manages billing/org settings and can grant/revoke admin within their own tenant. Exactly one per tenant, enforced by acis-platform-admin at role-assignment time (Keycloak has no native uniqueness constraint for this)." },
      { "name": "platform-admin", "description": "NETCRADUS platform operator - cross-tenant administration, no tenant_id claim required" }
    ]
  },
  "clients": [
    {
      "clientId": "acis-frontend",
      "name": "ACIS Frontend SPA",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost:3000/*",
        "http://localhost:3001/*",
        "http://localhost:3002/*"
      ],

      "webOrigins": [
        "http://localhost:3000",
        "http://localhost:3001",
        "http://localhost:3002"
      ],

      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:3000/*##http://localhost:3001/*##http://localhost:3002/*"

      },
      "protocol": "openid-connect",
      "fullScopeAllowed": true,
      "defaultClientScopes": ["acis-tenant", "roles", "email"]
    },
    {
      "clientId": "acis-backend",
      "name": "ACIS Backend Services",
      "enabled": true,
      "publicClient": false,
      "secret": "acis-backend-secret",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "authorizationServicesEnabled": false,
      "protocol": "openid-connect",
      "defaultClientScopes": ["acis-tenant", "roles", "email"]
    }
  ],
  "users": [
    {
      "username": "admin",
      "email": "admin@acme.local",
      "firstName": "ACIS",
      "lastName": "Admin",
      "enabled": true,
      "emailVerified": true,
      "realmRoles": ["admin", "engineer", "analyst", "viewer"],
      "attributes": {
        "tenant_id": ["11111111-1111-4111-8111-111111111111"]
      },
      "credentials": [
        {
          "type": "password",
          "value": "acis123",
          "temporary": false
        }
      ]
    },
    {
      "username": "analyst1",
      "email": "analyst1@acme.local",
      "firstName": "Alex",
      "lastName": "Chen",
      "enabled": true,
      "emailVerified": true,
      "realmRoles": ["analyst", "viewer"],
      "attributes": {
        "tenant_id": ["11111111-1111-4111-8111-111111111111"]
      },
      "credentials": [
        {
          "type": "password",
          "value": "acis123",
          "temporary": false
        }
      ]
    },
    {
      "username": "analyst2",
      "email": "analyst2@acme.local",
      "firstName": "Sam",
      "lastName": "Patel",
      "enabled": true,
      "emailVerified": true,
      "realmRoles": ["analyst", "viewer"],
      "attributes": {
        "tenant_id": ["11111111-1111-4111-8111-111111111111"]
      },
      "credentials": [
        {
          "type": "password",
          "value": "acis123",
          "temporary": false
        }
      ]
    },
    {
      "username": "platform-admin",
      "email": "platform-admin@netcradus.local",
      "firstName": "NETCRADUS",
      "lastName": "Ops",
      "enabled": true,
      "emailVerified": true,
      "realmRoles": ["platform-admin"],
      "credentials": [
        {
          "type": "password",
          "value": "acis123",
          "temporary": false
        }
      ]
    },
    {
      "username": "service-account-acis-backend",
      "serviceAccountClientId": "acis-backend",
      "clientRoles": {
        "realm-management": ["manage-users", "view-users", "view-realm"]
      }
    }
  ],
  "clientScopes": [
    {
      "name": "acis-tenant",
      "description": "Injects the ACIS tenant_id claim into every token from this user's tenant_id attribute.",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "tenant-id-mapper",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "tenant_id",
            "claim.name": "tenant_id",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "multivalued": "false"
          }
        }
      ]
    },
    {
      "name": "roles",
      "description": "Realm and client role claims (realm_access.roles, resource_access.*.roles) - required for any role-based check (e.g. platform-admin) to see role data in the token at all, and for Keycloak's own Admin REST API to honor a service account's granted client roles (e.g. acis-backend's manage-users/view-users).",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "false",
        "display.on.consent.screen": "true"
      },
      "protocolMappers": [
        {
          "name": "realm-roles-mapper",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "realm_access.roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "client-roles-mapper",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-client-role-mapper",
          "consentRequired": false,
          "config": {
            "usermodel.clientRoleMapping.clientId": "",
            "claim.name": "resource_access.${client_id}.roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "email",
      "description": "Email claim - used by TenantContextFilter to populate TenantContext.userEmail for audit logging.",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "email-mapper",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "email",
            "claim.name": "email",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    }
  ],
  "defaultDefaultClientScopes": ["roles", "email", "acis-tenant"],
  "defaultOptionalClientScopes": ["offline_access"]
}
