# NETCRADUS ACIS — production TLS termination
#
# Caddy automatically obtains and renews a real Let's Encrypt certificate for
# {$PUBLIC_APP_DOMAIN} the moment that value is a real public hostname whose
# DNS A/AAAA record points at this host (ports 80+443 must be reachable from
# the internet for the ACME HTTP-01 challenge). Until you set a real domain,
# this defaults to "localhost", where Caddy instead uses its own internal CA
# to serve locally-trusted HTTPS — enough to prove the whole proxy chain
# works before you ever touch a real domain or certificate.
#
# Two site blocks share the SAME hostname on two ports so only one certificate
# is needed: :443 for the app itself, :8443 for Keycloak (kept off the main
# port so Keycloak's own routes/assets never collide with the frontend's).
{
	# Let's Encrypt account contact — set ACME_EMAIL in .env to your real
	# address before going live; the placeholder below only matters if you
	# forget to (Caddy requires *some* value here, it doesn't verify deliverability).
	email {$ACME_EMAIL:admin@example.invalid}
}

{$PUBLIC_APP_DOMAIN:localhost} {
	encode gzip

	reverse_proxy frontend:80
}

{$PUBLIC_APP_DOMAIN:localhost}:8443 {
	reverse_proxy keycloak:8080
}
