# NETCRADUS ACIS — production TLS termination
#
# Caddy automatically obtains and renews a real Let's Encrypt certificate for
# {$PUBLIC_APP_DOMAIN} the moment that value is a real public hostname whose
# DNS A/AAAA record points at this host (ports 80+443 must be reachable from
# the internet for the ACME HTTP-01 challenge).
#
# Site blocks share the SAME hostname on different ports so only one
# certificate is needed: :443 for the app itself, :8443 for Keycloak, :8444
# for Grafana (kept off the main port so none of these collide with the
# frontend's own routes/assets). Prometheus/Alertmanager are deliberately
# NOT exposed here — they have no login of their own (Grafana does), so
# access them via an SSH tunnel to the Docker host instead (see
# infra/monitoring/MONITORING.md).
{
	email {$ACME_EMAIL:admin@example.invalid}
	servers {
		protocols h1 h2
	}
}

{$PUBLIC_APP_DOMAIN:localhost} {
	encode gzip

	# Baseline browser security headers — the app previously returned none of
	# these (Keycloak's own responses already set several natively, which is
	# why they were only missing here). frame-ancestors 'none' + X-Frame-
	# Options DENY closes the clickjacking gap; the rest is standard defense
	# in depth. Deliberately NOT setting script-src/style-src etc. here — a
	# full CSP needs testing against the app's actual resource loading to
	# avoid breaking it, so this only targets what the assessment flagged.
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Frame-Options "DENY"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Content-Security-Policy "frame-ancestors 'none'"
	}

	reverse_proxy frontend:80
}

{$PUBLIC_APP_DOMAIN:localhost}:8443 {
	reverse_proxy keycloak:8080
}

{$PUBLIC_APP_DOMAIN:localhost}:8444 {
	reverse_proxy grafana:3000
}

# Direct-IP visitors on plain HTTP get sent to the real domain instead of a
# dead end — HTTPS on the bare IP already fails at the TLS layer (Caddy's
# automatic HTTPS only holds a certificate for $PUBLIC_APP_DOMAIN), so this
# only needs to handle the plain-HTTP:80 case.
http://142.93.219.208 {
	redir https://{$PUBLIC_APP_DOMAIN}{uri} permanent
}
