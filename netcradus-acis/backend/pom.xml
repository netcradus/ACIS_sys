<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <!-- Dedicated upgrade pass (see git history for the prior 3.3.5->3.3.11
         patch and its since-superseded reasoning): Spring Boot 3.3.x reached
         OSS end-of-life 2025-06-30 with 3.3.13 as its last free Maven
         Central release - confirmed by direct query against
         repo1.maven.org, not just secondary trackers. Two of this project's
         own real-scanner-flagged Critical CVEs (Cassandra auto-config
         hostname verification, Spring Security header-writing) only have
         fixes published to VMware Tanzu's paid commercial support on the
         3.3.x line, never to the public repo. 3.5.x is the only line still
         under free OSS support (through 2027-07-31) and is Spring's own
         designated "bridge release" to 4.0 (deprecates rather than removes
         most of what 4.0 drops), making it the safer target than jumping
         straight to a major version. -->
    <version>3.5.16</version>
    <relativePath/>
  </parent>

  <groupId>com.netcradus.acis</groupId>
  <artifactId>acis-parent</artifactId>
  <version>1.0.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>NETCRADUS ACIS — Backend Parent</name>

  <modules>
    <module>acis-common</module>
    <module>acis-gateway</module>
    <module>acis-log-service</module>
    <module>acis-asset-service</module>
    <module>acis-threat-service</module>
    <module>acis-alerts</module>
    <module>acis-correlation</module>
    <module>acis-ingestion</module>
    <module>acis-soar</module>
    <module>acis-platform-admin</module>
  </modules>

  <properties>
    <java.version>21</java.version>
    <!-- Must track spring-boot-starter-parent's line: 2025.0.x is the
         Spring-Cloud-Release-Train compatible with Boot 3.5.x (2023.0.x was
         paired with Boot 3.3.x). -->
    <spring-cloud.version>2025.0.3</spring-cloud.version>
    <!-- Matches the running quay.io/keycloak/keycloak:24.0 server (infra/docker-compose.yml) -->
    <keycloak.version>24.0.5</keycloak.version>
    <maven.compiler.source>21</maven.compiler.source>
    <maven.compiler.target>21</maven.compiler.target>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <!-- Spring Boot 3.5.16's own BOM still ships tomcat 10.1.55 / netty
         4.1.135.Final, each one patch release short of actually clearing
         this project's own dependency-check findings (tomcat needs 10.1.57
         for CVE-2026-59083/59084; netty needs 4.1.136.Final for
         CVE-2026-56817/56820). Both are Spring Boot's own documented
         override properties (see docs.spring.io "Version Properties") for
         exactly this situation - a same-line patch ahead of what the BOM
         has caught up to yet, not an unmanaged/unsupported combination. -->
    <tomcat.version>10.1.57</tomcat.version>
    <netty.version>4.1.137.Final</netty.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.springframework.cloud</groupId>
        <artifactId>spring-cloud-dependencies</artifactId>
        <version>${spring-cloud.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>com.netcradus.acis</groupId>
        <artifactId>acis-common</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>org.keycloak</groupId>
        <artifactId>keycloak-admin-client</artifactId>
        <version>${keycloak.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <plugins>
      <!-- Real dependency CVE scanning (NVD database) - not bound to any
           default lifecycle phase (`mvn clean install`/`mvn test` are
           unaffected), run explicitly via:
             mvn org.owasp:dependency-check-maven:aggregate
           against the whole reactor at once (one combined report covering
           every module's dependencies, dependency-check-report.html /
           dependency-check-report.json in this directory). See ci.yml's
           "Backend dependency security scan" step and
           SECURITY_SCAN_FINDINGS.md for this project's own documented,
           individually-reviewed findings and suppressions - failing the
           whole build on an unreviewed CVE match (including ones this repo
           has already investigated and deliberately deferred, like
           GHSA-wwpq-f5c3-7hvx noted above) is not the goal here; a real,
           readable report that gets looked at is. -->
      <plugin>
        <groupId>org.owasp</groupId>
        <artifactId>dependency-check-maven</artifactId>
        <version>10.0.4</version>
        <configuration>
          <format>ALL</format>
          <!-- Suppressions are reviewed individually, never blanket -
               see suppressions.xml's own entries for the reasoning behind
               each one. -->
          <suppressionFiles>
            <suppressionFile>${maven.multiModuleProjectDirectory}/dependency-check-suppressions.xml</suppressionFile>
          </suppressionFiles>
          <!-- Only fail the build (non-zero exit) for CVSS >= 9 (Critical) -
               High/Medium/Low findings still appear in the report for
               human review rather than silently blocking every build on
               something that needs investigation, not an automatic gate. -->
          <failBuildOnCVSS>9</failBuildOnCVSS>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
