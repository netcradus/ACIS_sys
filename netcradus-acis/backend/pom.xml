<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <!-- 3.3.5 had GHSA-rc42-6c7j-7h5r (EndpointRequest.to() builds the wrong
         matcher for non-exposed actuator endpoints) - fixed in 3.3.11, a
         same-minor-line patch bump with no breaking API changes per Spring
         Boot's own versioning policy. A second real CVE (GHSA-wwpq-f5c3-7hvx,
         predictable temp directory) has no fix within the 3.3.x line at all -
         it needs 3.5.14+/4.0.6, a materially larger upgrade (Spring Cloud
         train compatibility, broader regression surface) intentionally left
         for a dedicated, separately-tested upgrade rather than bundled here. -->
    <version>3.3.11</version>
    <relativePath/>
  </parent>

  <groupId>com.netcradus.acis</groupId>
  <artifactId>acis-parent</artifactId>
  <version>1.0.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>NETCRADUS ACIS — Backend Parent</name>

  <modules>
    <module>acis-common</module>
    <module>acis-gateway</module>
    <module>acis-log-service</module>
    <module>acis-asset-service</module>
    <module>acis-threat-service</module>
    <module>acis-alerts</module>
    <module>acis-correlation</module>
    <module>acis-ingestion</module>
    <module>acis-soar</module>
    <module>acis-platform-admin</module>
  </modules>

  <properties>
    <java.version>21</java.version>
    <spring-cloud.version>2023.0.3</spring-cloud.version>
    <!-- Matches the running quay.io/keycloak/keycloak:24.0 server (infra/docker-compose.yml) -->
    <keycloak.version>24.0.5</keycloak.version>
    <maven.compiler.source>21</maven.compiler.source>
    <maven.compiler.target>21</maven.compiler.target>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.springframework.cloud</groupId>
        <artifactId>spring-cloud-dependencies</artifactId>
        <version>${spring-cloud.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>com.netcradus.acis</groupId>
        <artifactId>acis-common</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>org.keycloak</groupId>
        <artifactId>keycloak-admin-client</artifactId>
        <version>${keycloak.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>
</project>
