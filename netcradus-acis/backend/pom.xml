<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <!-- Dedicated upgrade pass (see git history for the prior 3.3.5->3.3.11
         patch and its since-superseded reasoning): Spring Boot 3.3.x reached
         OSS end-of-life 2025-06-30 with 3.3.13 as its last free Maven
         Central release - confirmed by direct query against
         repo1.maven.org, not just secondary trackers. Two of this project's
         own real-scanner-flagged Critical CVEs (Cassandra auto-config
         hostname verification, Spring Security header-writing) only have
         fixes published to VMware Tanzu's paid commercial support on the
         3.3.x line, never to the public repo. 3.5.x is the only line still
         under free OSS support (through 2027-07-31) and is Spring's own
         designated "bridge release" to 4.0 (deprecates rather than removes
         most of what 4.0 drops), making it the safer target than jumping
         straight to a major version. -->
    <version>3.5.16</version>
    <relativePath/>
  </parent>

  <groupId>com.netcradus.acis</groupId>
  <artifactId>acis-parent</artifactId>
  <version>1.0.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>NETCRADUS ACIS — Backend Parent</name>

  <modules>
    <module>acis-common</module>
    <module>acis-gateway</module>
    <module>acis-log-service</module>
    <module>acis-asset-service</module>
    <module>acis-threat-service</module>
    <module>acis-alerts</module>
    <module>acis-correlation</module>
    <module>acis-ingestion</module>
    <module>acis-soar</module>
    <module>acis-platform-admin</module>
  </modules>

  <properties>
    <java.version>21</java.version>
    <!-- Must track spring-boot-starter-parent's line: 2025.0.x is the
         Spring-Cloud-Release-Train compatible with Boot 3.5.x (2023.0.x was
         paired with Boot 3.3.x). -->
    <spring-cloud.version>2025.0.3</spring-cloud.version>
    <!-- Matches the running quay.io/keycloak/keycloak:24.0 server (infra/docker-compose.yml) -->
    <keycloak.version>24.0.5</keycloak.version>
    <maven.compiler.source>21</maven.compiler.source>
    <maven.compiler.target>21</maven.compiler.target>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <!-- Spring Boot 3.5.16's own BOM still ships tomcat 10.1.55 / netty
         4.1.135.Final, each one patch release short of actually clearing
         this project's own dependency-check findings (tomcat needs 10.1.57
         for CVE-2026-59083/59084; netty needs 4.1.136.Final for
         CVE-2026-56817/56820). Both are Spring Boot's own documented
         override properties (see docs.spring.io "Version Properties") for
         exactly this situation - a same-line patch ahead of what the BOM
         has caught up to yet, not an unmanaged/unsupported combination. -->
    <tomcat.version>10.1.57</tomcat.version>
    <netty.version>4.1.137.Final</netty.version>
    <!-- High/Medium dependency-CVE remediation pass (see
         dependency-check-suppressions.xml for the ~30 findings determined
         to be genuine false positives instead - CPE overmatches against a
         different language/product sharing the same artifact name). These
         are the real, applicable fixes: same-line patches only, each
         verified against its actual CVE's fixed-version advisory before
         bumping, not a blanket "upgrade everything" pass. -->
    <log4j2.version>2.26.1</log4j2.version>
    <postgresql.version>42.7.12</postgresql.version>
    <commons-lang3.version>3.18.0</commons-lang3.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.springframework.cloud</groupId>
        <artifactId>spring-cloud-dependencies</artifactId>
        <version>${spring-cloud.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>com.netcradus.acis</groupId>
        <artifactId>acis-common</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>org.keycloak</groupId>
        <artifactId>keycloak-admin-client</artifactId>
        <version>${keycloak.version}</version>
      </dependency>
      <!-- CVE-2024-7254: protobuf-java stack overflow parsing deeply-nested
           untrusted input (real, applicable - fixed same-3.25.x-line).
           CVE-2026-0994 (also flagged against this same jar) is a
           documented false positive - see suppressions.xml, it's Python
           protobuf's json_format module, not Java. -->
      <dependency>
        <groupId>com.google.protobuf</groupId>
        <artifactId>protobuf-java</artifactId>
        <version>3.25.5</version>
      </dependency>
      <!-- CVE-2024-21742: MIME4J DOM header injection when composing
           messages - real, applicable to acis-soar's email sending path. -->
      <dependency>
        <groupId>org.apache.james</groupId>
        <artifactId>apache-mime4j-core</artifactId>
        <version>0.8.14</version>
      </dependency>
      <dependency>
        <groupId>org.apache.james</groupId>
        <artifactId>apache-mime4j-dom</artifactId>
        <version>0.8.14</version>
      </dependency>
      <!-- CVE-2024-7246: grpc-core is ALSO pulled in transitively via
           net.devh:grpc-common-spring-boot (a third path besides the
           grpc-stub/grpc-protobuf declared directly in
           acis-threat-service/pom.xml), independently resolving to the
           old 1.63.0 even after those two were bumped - verified via
           `mvn dependency:tree`, not assumed. -->
      <dependency>
        <groupId>io.grpc</groupId>
        <artifactId>grpc-core</artifactId>
        <version>1.63.2</version>
      </dependency>
      <dependency>
        <groupId>io.grpc</groupId>
        <artifactId>grpc-util</artifactId>
        <version>1.63.2</version>
      </dependency>
      <dependency>
        <groupId>io.grpc</groupId>
        <artifactId>grpc-inprocess</artifactId>
        <version>1.63.2</version>
      </dependency>
      <dependency>
        <groupId>io.grpc</groupId>
        <artifactId>grpc-netty-shaded</artifactId>
        <version>1.63.2</version>
      </dependency>
      <!-- jackson.version/commons-io.version aren't Spring Boot BOM
           property names it actually honors (verified: the property-based
           override silently did nothing, still resolved 2.21.4/2.11.0 -
           explicit dependencyManagement entries are the reliable
           mechanism, unlike log4j2.version/postgresql.version/
           commons-lang3.version above which Boot DOES recognize). -->
      <dependency>
        <groupId>com.fasterxml.jackson.core</groupId>
        <artifactId>jackson-databind</artifactId>
        <version>2.21.5</version>
      </dependency>
      <dependency>
        <groupId>commons-io</groupId>
        <artifactId>commons-io</artifactId>
        <version>2.20.0</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <plugins>
      <!-- Real dependency CVE scanning (NVD database) - not bound to any
           default lifecycle phase (`mvn clean install`/`mvn test` are
           unaffected), run explicitly via:
             mvn org.owasp:dependency-check-maven:aggregate
           against the whole reactor at once (one combined report covering
           every module's dependencies, dependency-check-report.html /
           dependency-check-report.json in this directory). See ci.yml's
           "Backend dependency security scan" step and
           SECURITY_SCAN_FINDINGS.md for this project's own documented,
           individually-reviewed findings and suppressions - failing the
           whole build on an unreviewed CVE match (including ones this repo
           has already investigated and deliberately deferred, like
           GHSA-wwpq-f5c3-7hvx noted above) is not the goal here; a real,
           readable report that gets looked at is. -->
      <plugin>
        <groupId>org.owasp</groupId>
        <artifactId>dependency-check-maven</artifactId>
        <version>10.0.4</version>
        <configuration>
          <format>ALL</format>
          <!-- Suppressions are reviewed individually, never blanket -
               see suppressions.xml's own entries for the reasoning behind
               each one. -->
          <suppressionFiles>
            <suppressionFile>${maven.multiModuleProjectDirectory}/dependency-check-suppressions.xml</suppressionFile>
          </suppressionFiles>
          <!-- Only fail the build (non-zero exit) for CVSS >= 9 (Critical) -
               High/Medium/Low findings still appear in the report for
               human review rather than silently blocking every build on
               something that needs investigation, not an automatic gate. -->
          <failBuildOnCVSS>9</failBuildOnCVSS>
          <!-- Real CI failure found running this for the first time
               (GitHub Actions): "Invalid credentials provided for OSS
               Index (401)" - the whole build failed on this even though
               it's a supplementary data source, not the actual NVD-based
               scan the failBuildOnCVSS gate above relies on. Sonatype's
               OSS Index has its own separate (optional) auth/rate-limit
               system unrelated to NVD; disabling it here means CVE
               detection still runs against NVD, CISA KEV, and RetireJS
               exactly as before, just without this one extra data source
               that has no working credentials configured anywhere in
               this pipeline.
          -->
          <ossindexAnalyzerEnabled>false</ossindexAnalyzerEnabled>
          <!-- Explicit, stable path (rather than the plugin's own
               version-tucked default under ~/.m2) so CI can cache it
               directly with actions/cache - see .github/workflows/ci.yml.
               Without a cache, a cold run has to download the entire NVD
               CVE database from scratch, which really did take ~59
               minutes on a fresh GitHub Actions runner (observed, not
               estimated) even though the actual dependency scan itself
               only takes ~16 seconds once the data is present. -->
          <dataDirectory>${user.home}/.dependency-check-data</dataDirectory>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
