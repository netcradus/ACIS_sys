# Root level gitignore
.env
.env.local
.env.*.local
.vscode/
.idea/
*.log
*.err
out/
build/

# Kiro credentials — never commit. Real content is dropped in locally by the
# operator, referenced by docker-compose's kiro-gateway volume mount.
secrets/

# ai-service's local classifier version store — runtime state (trained model
# files + manifest.json), same role as the ai_models_data Docker volume in
# prod. Never source-controlled.
ai-service/models/

# Rendered from alertmanager.yml.template by infra/scripts/deploy.sh -
# contains real SMTP credentials once rendered, never commit it. The
# .template (placeholders only) IS committed.
infra/monitoring/alertmanager.yml

# Regenerated from docker-compose.prod.yml by
# infra/scripts/generate-aws-compose.py on every AWS deploy - never
# hand-edited, never source-controlled.
docker-compose.aws.yml
