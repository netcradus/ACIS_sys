# NETCRADUS ACIS — Production environment template
#
# Copy this file to `.env` (already gitignored — never commit the real file)
# next to docker-compose.prod.yml, fill in real values, then:
#   docker compose -f docker-compose.prod.yml up -d --build
#
# Every value below marked "CHANGE ME" is a real secret or a real hostname
# that only you know — this repo cannot guess them for you.

# ── Domain / TLS ────────────────────────────
# Bare hostname (no scheme, no port) — must have a DNS A/AAAA record pointing
# at this host before Caddy can obtain a real Let's Encrypt certificate.
# Leave as "localhost" to test the whole stack over locally-trusted HTTPS
# before you own a domain (see infra/caddy/Caddyfile).
PUBLIC_APP_DOMAIN=localhost
# Contact email for Let's Encrypt account registration/expiry notices.
# Required even for the localhost/internal-CA case (Caddy just won't use it).
ACME_EMAIL=CHANGE_ME_you@example.com

# ── PostgreSQL ──────────────────────────────
DB_NAME=acis
# Password for the "acis" bootstrap/admin role (Postgres superuser — only
# used for ops/manual psql access, never by the application services).
POSTGRES_ADMIN_PASSWORD=CHANGE_ME_use_a_long_random_password
# Password for "acis_app", the ordinary (non-superuser) role every acis-*
# service connects as — required for Row Level Security to actually apply,
# since Postgres RLS never restricts a superuser. Created automatically by
# infra/postgres-init/01-create-app-role.sh on first boot.
DB_PASSWORD=CHANGE_ME_use_a_different_long_random_password
# Password for "keycloak", the role/database Keycloak uses for its own
# storage (realms, users, sessions) — separate from the acis app database.
# Created automatically by infra/postgres-init/02-create-keycloak-db.sh.
KEYCLOAK_DB_PASSWORD=CHANGE_ME_use_yet_another_long_random_password

# ── Keycloak ────────────────────────────────
# Bootstrap admin for the Keycloak *admin console* itself (not an ACIS app
# user). Do not reuse the local-dev admin/admin credentials.
KEYCLOAK_ADMIN_USER=CHANGE_ME
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME_use_a_long_random_password
KEYCLOAK_REALM=acis
# Admin console + login pages are reachable at https://<PUBLIC_APP_DOMAIN>:8443
# once the stack is up (Caddy fronts Keycloak on that port with the same
# certificate as the main app). No separate URL/port variables needed here —
# everything derives from PUBLIC_APP_DOMAIN above.

# Confidential client secret for the "acis-backend" Keycloak client's
# service account — used by platform-admin and soar for Keycloak Admin REST
# calls (creating/managing users, and — see InvitationService — provisioning
# a real login the moment an invited member accepts, never before). Set to
# whatever secret you configured for this client in the Keycloak admin
# console (Clients > acis-backend > Credentials).
KEYCLOAK_BACKEND_CLIENT_SECRET=CHANGE_ME_your_acis_backend_client_secret

# ── Internal service-to-service auth ────────
# Shared secret real internal callers (scheduled jobs with no end-user JWT —
# AssetDriftDetectionService, ComplianceService, IntegrationPollerService)
# attach as X-Internal-Service-Key — see InternalServiceKeyMatcher /
# RbacEnforcementFilter. Must be identical across every backend service;
# generate with: openssl rand -base64 32
INTERNAL_SERVICE_KEY=CHANGE_ME_use_openssl_rand_base64_32

# ── SMTP (required for real invitation emails — see EmailService) ──
# Any standard SMTP provider works; example values below are for Zoho Mail.
# Leaving these unset doesn't break invites — the real invite record and its
# accept link still get created — but the email genuinely won't send, and
# EmailService logs that honestly instead of pretending it worked.
SMTP_HOST=CHANGE_ME_smtp.yourprovider.com
SMTP_PORT=465
SMTP_USERNAME=CHANGE_ME_you@yourdomain.com
SMTP_PASSWORD=CHANGE_ME_your_smtp_password
SMTP_SSL=true
MAIL_FROM_EMAIL=CHANGE_ME_you@yourdomain.com
MAIL_FROM_NAME=ACIS Security

# ── AI (real providers only — see ai-service/app/providers.py) ─────────
# Every LLM-backed feature (/ai/explain, /ai/explain/stream, /ai/query)
# tries these real providers in order and stops at the first one that's
# configured and succeeds. If NONE are configured, or every configured one
# fails, the feature returns a real "AI unavailable" error — there is no
# mock/fake fallback in this deployment; leaving all of these unset simply
# means those features are unavailable, not that they silently pretend to
# work.
#
# Primary — NVIDIA NIM (get a key at https://build.nvidia.com/). Tried
# first, and the only backend /ai/explain/stream streams token-by-token
# from unless it fails before yielding anything.
# NVIDIA_API_KEY=CHANGE_ME_your_nvidia_api_key
# NVIDIA_MODEL=meta/llama-3.1-8b-instruct
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# NVIDIA_REQUEST_TIMEOUT_SECONDS=30
#
# Real fallback #1 — OpenRouter (get a key at https://openrouter.ai/keys).
# Only used if NVIDIA isn't configured or fails.
# OPENROUTER_API_KEY=CHANGE_ME_your_openrouter_api_key
# OPENROUTER_MODEL=openai/gpt-4o-mini
#
# Real fallback #2 — Groq's official free tier (get a free key at
# https://console.groq.com/keys). Only used if NVIDIA and OpenRouter are
# both unconfigured or fail.
# GROQ_API_KEY=CHANGE_ME_your_groq_api_key
# GROQ_MODEL=llama-3.3-70b-versatile
#
# Real fallback #3 — kiro-gateway (an unofficial, community-maintained
# proxy — read the risk notes before enabling). Only used if none of the
# above are configured or all fail.
#
# To enable Kiro: set both vars below, drop your Kiro Desktop Auth JSON at
# ./secrets/kiro-auth-token.json (gitignored, never commit it), then start
# the stack with the extra profile flag:
#   docker compose -f docker-compose.prod.yml --profile kiro up -d --build
#
# KIRO_GATEWAY_URL=http://kiro-gateway:8000
# KIRO_GATEWAY_API_KEY=CHANGE_ME_invent_your_own_password_here
# KIRO_MODEL=claude-sonnet-4-5

# ── Threat Intel enrichment (optional — leave unset for an explicit
# "unconfigured" result instead of fake data) ─────────
# VIRUSTOTAL_API_KEY=CHANGE_ME_your_virustotal_api_key
# ABUSEIPDB_API_KEY=CHANGE_ME_your_abuseipdb_api_key

# ── Automated backups (see infra/scripts/BACKUP_RESTORE.md) — both have
# working defaults below, only uncomment to change them ─────────
# How many days of daily pg_dump backups to keep on the `backup_data` volume.
# BACKUP_RETENTION_DAYS=14
# UTC hour (0-23) the daily backup runs at.
# BACKUP_HOUR_UTC=2

# ── Monitoring (see infra/monitoring/MONITORING.md) ─────────
# Grafana login — reachable at https://<PUBLIC_APP_DOMAIN>:8444. Required;
# do not reuse the dev docker-compose's "admin/admin".
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_generate_a_real_password
