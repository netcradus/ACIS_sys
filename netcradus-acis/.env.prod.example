# NETCRADUS ACIS — Production environment template
#
# Copy this file to `.env` (already gitignored — never commit the real file)
# next to docker-compose.prod.yml, fill in real values, then:
#   docker compose -f docker-compose.prod.yml up -d --build
#
# Every value below marked "CHANGE ME" is a real secret or a real hostname
# that only you know — this repo cannot guess them for you.

# ── Domain / TLS ────────────────────────────
# Bare hostname (no scheme, no port) — must have a DNS A/AAAA record pointing
# at this host before Caddy can obtain a real Let's Encrypt certificate.
# Leave as "localhost" to test the whole stack over locally-trusted HTTPS
# before you own a domain (see infra/caddy/Caddyfile).
PUBLIC_APP_DOMAIN=localhost
# Contact email for Let's Encrypt account registration/expiry notices.
# Required even for the localhost/internal-CA case (Caddy just won't use it).
ACME_EMAIL=CHANGE_ME_you@example.com

# ── PostgreSQL ──────────────────────────────
DB_NAME=acis
# Password for the "acis" bootstrap/admin role (Postgres superuser — only
# used for ops/manual psql access, never by the application services).
POSTGRES_ADMIN_PASSWORD=CHANGE_ME_use_a_long_random_password
# Password for "acis_app", the ordinary (non-superuser) role every acis-*
# service connects as — required for Row Level Security to actually apply,
# since Postgres RLS never restricts a superuser. Created automatically by
# infra/postgres-init/01-create-app-role.sh on first boot.
DB_PASSWORD=CHANGE_ME_use_a_different_long_random_password
# Password for "keycloak", the role/database Keycloak uses for its own
# storage (realms, users, sessions) — separate from the acis app database.
# Created automatically by infra/postgres-init/02-create-keycloak-db.sh.
KEYCLOAK_DB_PASSWORD=CHANGE_ME_use_yet_another_long_random_password

# ── Keycloak ────────────────────────────────
# Bootstrap admin for the Keycloak *admin console* itself (not an ACIS app
# user). Do not reuse the local-dev admin/admin credentials.
KEYCLOAK_ADMIN_USER=CHANGE_ME
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME_use_a_long_random_password
KEYCLOAK_REALM=acis
# Admin console + login pages are reachable at https://<PUBLIC_APP_DOMAIN>:8443
# once the stack is up (Caddy fronts Keycloak on that port with the same
# certificate as the main app). No separate URL/port variables needed here —
# everything derives from PUBLIC_APP_DOMAIN above.
