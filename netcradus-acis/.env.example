# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=acis
DB_USER=acis
DB_PASSWORD=acis_dev_password

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Elasticsearch
ES_HOST=http://localhost:9200

# Keycloak
# Local dev: http://localhost:8180  |  Docker internal: http://keycloak:8180
KEYCLOAK_URL=http://localhost:8180
KEYCLOAK_REALM=acis
KEYCLOAK_CLIENT_ID=acis-backend
KEYCLOAK_CLIENT_SECRET=acis-backend-secret

# AI Service
AI_SERVICE_URL=http://localhost:8090
OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...

# MinIO / S3
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=acis
S3_SECRET_KEY=acis_minio_password
S3_BUCKET=acis-reports

# Frontend (Vite)
VITE_API_BASE_URL=http://localhost:8080
VITE_WS_URL=ws://localhost:8080/ws
VITE_KEYCLOAK_URL=http://localhost:8180
VITE_KEYCLOAK_REALM=acis
VITE_KEYCLOAK_CLIENT_ID=acis-frontend
