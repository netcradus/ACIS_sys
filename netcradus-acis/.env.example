# PostgreSQL
# Services connect as acis_app (a non-superuser role), never as the "acis"
# bootstrap/admin role — Postgres Row Level Security never applies to
# superusers, so app traffic must go through an ordinary role for the
# tenant-isolation policies to mean anything. See
# infra/postgres-init/01-create-app-role.sh.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=acis
DB_USER=acis_app
DB_PASSWORD=acis_app_dev_password

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Elasticsearch
ES_HOST=http://localhost:9200

# Keycloak
# Local dev: http://localhost:8180  |  Docker internal: http://keycloak:8180
KEYCLOAK_URL=http://localhost:8180
KEYCLOAK_REALM=acis
KEYCLOAK_CLIENT_ID=acis-backend
KEYCLOAK_CLIENT_SECRET=acis-backend-secret

# AI Service — real providers only, see ai-service/app/providers.py. No
# provider configured means AI features return a real "unavailable" error,
# never a fake response.
AI_SERVICE_URL=http://localhost:8090
# Primary LLM backend, tried first
# NVIDIA_API_KEY=nvapi-...
# NVIDIA_MODEL=meta/llama-3.1-8b-instruct
# Real fallback #1
# OPENROUTER_API_KEY=sk-or-v1-...
# OPENROUTER_MODEL=openai/gpt-4o-mini
# Real fallback #2 (Groq official free tier)
# GROQ_API_KEY=gsk_...
# GROQ_MODEL=llama-3.3-70b-versatile
# Real fallback #3 via kiro-gateway (unofficial)
# KIRO_GATEWAY_URL=http://kiro-gateway:8000
# KIRO_GATEWAY_API_KEY=...
# Threat intel enrichment — see ai-service/app/threat_intel_client.py
# VIRUSTOTAL_API_KEY=...
# ABUSEIPDB_API_KEY=...

# Frontend (Vite)
VITE_API_BASE_URL=http://localhost:8080
VITE_WS_URL=ws://localhost:8080/ws
VITE_KEYCLOAK_URL=http://localhost:8180
VITE_KEYCLOAK_REALM=acis
VITE_KEYCLOAK_CLIENT_ID=acis-frontend
